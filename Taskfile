function is_shell_file {
  case "$1" in
  *.bash | *.sh) return 0 ;;
  esac

  if head -n 1 "$1" | grep -Eq '^#!.*(bash|dash|ksh|zsh|sh)([[:space:]]|$)'; then
    return 0
  fi

  file "$1" | grep -q 'shell script'
}

function task:lint { ## Check sh files with shellcheck
  title "Check sh files with shellcheck"

  local failed=0
  for f in $(find . -type f -not -path '*.git*' -not -path '*/.history/*' | sort -u); do
    if is_shell_file "$f"; then
      if ! git check-ignore -q "$f"; then
        if shellcheck "$f"; then
          echo "No issues found: $f"
        else
          failed=1
        fi
      fi
    fi
  done

  return "$failed"
}

function task:format { ## Format sh and json files
  title "Format sh files"

  for f in $(find . -type f -not -path '*.git*' -not -path '*/.history/*' | sort -u); do
    if is_shell_file "$f"; then
      if ! git check-ignore -q "$f"; then
        shfmt -w "$f" && echo "Successfully formatted: $f"
      fi
    fi
  done

  title "Format json files"

  for f in $(find . -type f \( -name '*.json' -o -name '*.jsonc' \) -not -path '*.git*' -not -path '*/.history/*' | sort -u); do
    if ! git check-ignore -q "$f"; then
      npx --yes prettier --log-level warn --trailing-comma none --write "$f" && echo "Successfully formatted: $f"
    fi
  done
}

